[Unit]
Description=DC Bot Web Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dc-bot
EnvironmentFile=/opt/dc-bot/web/.env
ExecStart=/opt/dc-bot/venv/bin/python -m uvicorn web.app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
User=dc-bot-web
Group=dc-bot-web

# The dashboard runs as a dedicated unprivileged account. SQLite data lives in
# /opt/dc-bot/data and legacy DB paths are symlinks into that directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/opt/dc-bot/data
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
