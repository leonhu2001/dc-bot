# Existing order/business database. Keep this separate from market history.
DATABASE_URL=sqlite:////opt/dc-bot/web_dashboard.db

# Optional independent database for game market history. Production target: PostgreSQL.
# Example: postgresql+psycopg2://market_user:password@127.0.0.1:5432/mowan_market
MARKET_DATABASE_URL=
# Data older than this is shown as stale and must not trigger alerts.
MARKET_STALE_SECONDS=2700

