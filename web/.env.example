DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://mowanentertainment.com/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# 總管：整店最高管理
ADMIN_ROLE_IDS=1537067761141030972
# 客服：日常營運後台
CUSTOMER_SERVICE_ROLE_IDS=1482084782031638548
WORKER_ROLE_IDS=1500234130871550004,1500234170943934544,1500751039060643990,1500751059239440575,1482080315798192210
COMPANION_ROLE_IDS=1500751059239440575,1482080315798192210

# Existing order/business database. Keep this separate from market history.
DATABASE_URL=sqlite:////opt/dc-bot/web_dashboard.db

# Optional independent database for game market history. Production target: PostgreSQL.
# Example: postgresql+psycopg2://market_user:password@127.0.0.1:5432/mowan_market
MARKET_DATABASE_URL=
# Market providers are opt-in. Leave blank until MARKET_DATABASE_URL is configured.
# Verified Taiwan/Garena public reader: MARKET_PROVIDER=852941-tw
MARKET_PROVIDER=
MARKET_852941_BASE_URL=https://app.852941.xyz
# Worker games and polling cadence. Source updates about every 15 minutes;
# polling is globally shared, never per-user.
MARKET_GAME_KEYS=delta_force
MARKET_POLL_SECONDS=900
MARKET_LOG_LEVEL=INFO
# Data older than this is shown as stale and must not trigger alerts.
MARKET_STALE_SECONDS=2700

# Optional browser Web Push. Generate one P-256 VAPID key pair and keep the private key secret.
# Public/private values are URL-safe base64 strings; subject should be mailto: or an https URL.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@mowanentertainment.com

WEB_SECRET_KEY=change-this-to-a-long-random-string
WEB_COOKIE_HTTPS_ONLY=true
WEB_ALLOWED_ORIGINS=https://mowanentertainment.com,https://www.mowanentertainment.com
